<Project Sdk="Microsoft.NET.Sdk">

  <!-- The button beside the Claude app's new-session chip row (WinForms window). Depends on
       nothing of ours. UseWPF is here for the UI Automation client
       assemblies only (UIAutomationClient/Types ship in the WPF profile); no WPF UI is used. -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
