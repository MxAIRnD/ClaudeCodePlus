<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SUT is a WinForms library (and draws with System.Drawing), so this project carries the
       desktop framework too. The DI container is here to resolve the registered window
       (constructed, never shown). -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Feature.ContextBar\Feature.ContextBar.csproj" />
  </ItemGroup>

</Project>
